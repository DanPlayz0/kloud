DATABASE_URL=postgres://kloud:kloud_local@localhost:5432/kloud
PUBLIC_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
PORT=3000
# Required for Cloud DNS. Keep stable and back it up separately from PostgreSQL.
DNS_ENCRYPTION_KEY=
# Required for encrypted service configuration drafts (64 hexadecimal characters).
PLATFORM_ENCRYPTION_KEY=

# Optional TOTP: 32 random bytes as 64 hex characters. Keep stable and back up securely.
AUTH_ENCRYPTION_KEY=
# Optional Email 2FA. Disabled unless SMTP_HOST and SMTP_FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# starttls (587), implicit (465), or plain (local development only).
SMTP_TLS=starttls
