# Local Compose defaults. For production use a strong password in BOTH values.
POSTGRES_PASSWORD=dedi_dash_local
DATABASE_URL=postgres://dedi_dash:dedi_dash_local@postgres:5432/dedi_dash
PUBLIC_ORIGIN=http://localhost:8080
WEBAUTHN_RP_ID=localhost
# Create a connector token in Administration > Connectors before enabling profile.
CONNECTOR_TOKEN=
CONNECTOR_HOST=docker-host
DOCKER_GID=0
DOCKER_ENABLED=true
# PM2 requires a Compose override with matching UID/GID and socket/log mounts.
# See docs/PM2.md before enabling it.
PM2_ENABLED=false
# Opt in to GitHub-triggered builds on this connector (see docs/DEPLOYMENTS.md).
DEPLOYMENTS_ENABLED=false
DEPLOYMENTS_HELPER_IMAGE=dedi-dash-build-helper:local
DEPLOYMENTS_BUILDKIT_IMAGE=moby/buildkit:v0.28.0-rootless
DEPLOYMENTS_BUILD_MEMORY_MB=2048
# Optional GitHub token with read access to private deployment repositories.
DEPLOYMENTS_GITHUB_TOKEN=
# Required to connect DNS providers: 32 random bytes encoded as 64 hex characters.
DNS_ENCRYPTION_KEY=
# Required for service configuration drafts. Keep stable and back up securely.
PLATFORM_ENCRYPTION_KEY=
RUNTIME_ENABLED=false
PROXY_ENABLED=false
PROXY_NGINX_IMAGE=nginx:stable-alpine
PROXY_CERTBOT_IMAGE=certbot/certbot:latest
