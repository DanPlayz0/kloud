# Copy to .env next to compose.connector.yaml on the connector host.
CONNECTOR_IMAGE=ghcr.io/danplayz0/kloud-connector:latest
API_URL=https://dashboard.example.com/api/
CONNECTOR_TOKEN=
CONNECTOR_HOST=upstream-server
# On the Docker host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

DOCKER_ENABLED=true
POLL_INTERVAL_MS=5000
HEALTH_PORT=3001
RUNTIME_ENABLED=false
PROXY_ENABLED=false
PROXY_NGINX_IMAGE=nginx:stable-alpine
PROXY_CERTBOT_IMAGE=certbot/certbot:latest

# Builds also require a writable deployment bind mount; see docs/CONTAINER_IMAGES.md.
DEPLOYMENTS_ENABLED=false
DEPLOYMENTS_DIR=/var/lib/kloud/deployments
DEPLOYMENTS_HELPER_IMAGE=ghcr.io/danplayz0/kloud-build-helper:latest
DEPLOYMENTS_BUILDKIT_IMAGE=moby/buildkit:v0.28.0-rootless
DEPLOYMENTS_BUILD_MEMORY_MB=2048
# DEPLOYMENTS_GITHUB_TOKEN=

# Add -f compose.connector.pm2.yaml to enable PM2 and its home bind mount.
# Use the OS user running the existing PM2 daemon: id -u app; id -g app.
PM2_ENABLED=false
# PM2_HOME=/home/app/.pm2
# PM2_UID=1000
# PM2_GID=1000
