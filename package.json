{
  "name": "dedi-dash",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n website,api \"npm run dev --workspace @dedi-dash/website\" \"npm run dev --workspace @dedi-dash/api\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
